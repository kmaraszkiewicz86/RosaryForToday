<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.kmaraszkiewicz86.rosaryfortoday" android:versionName="rosaryfortoday">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:supportsRtl="true" android:label="Różaniec na dzisiaj">
		<receiver android:name=".Platforms.Android.RosaryTodayAppWidgetProvider" android:exported="true" android:label="RosaryForToday Widget">
			<intent-filter>
				<action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
